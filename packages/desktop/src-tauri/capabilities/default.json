{
  "identifier": "management",
  "description": "Only the local management window may inspect, start, stop, diagnose and configure the selected runtime integration.",
  "windows": ["management"],
  "permissions": [
    "allow-management-status",
    "allow-management-open-data-directory",
    "allow-management-open-service",
    "allow-management-start",
    "allow-management-stop",
    "allow-management-doctor",
    "allow-management-agents-state",
    "allow-management-agents-change",
    "allow-management-agents-forget",
    "allow-management-preferences",
    "allow-management-preferences-change",
    "allow-management-omr-settings-set",
    "allow-management-autostart-set",
    "allow-management-storage-status",
    "allow-management-storage-cleanup",
    "allow-management-scores",
    "allow-management-archived-scores",
    "allow-management-score-preview",
    "allow-management-archive-score",
    "allow-management-restore-score",
    "allow-management-delete-score",
    "allow-management-open-score",
    "allow-update-state",
    "allow-update-check",
    "allow-update-cancel",
    "allow-release-notes",
    "allow-update-apply",
    "allow-update-token-set",
    "allow-open-external-url",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
