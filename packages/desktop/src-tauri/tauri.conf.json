{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ossia",
  "version": "0.1.0",
  "identifier": "dev.ossia.desktop",
  "build": {
    "beforeDevCommand": "node scripts/ui-dev.mjs",
    "beforeBuildCommand": "node scripts/ui-dev.mjs build",
    "devUrl": "http://127.0.0.1:5173/admin.html",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ossia 管理",
        "width": 920,
        "height": 760,
        "minWidth": 520,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "label": "management",
        "url": "admin.html"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": ["ipc: http://ipc.localhost", "ws://127.0.0.1:5173"],
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "publisher": "Ossia",
    "copyright": "Copyright © 2026 Ossia",
    "category": "public.app-category.music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
