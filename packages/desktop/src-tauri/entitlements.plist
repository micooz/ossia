<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The local runtime launches the bundled LilyPond and Python converters. It does not load
       unsigned executable memory or JIT code in-process, so hardened-runtime JIT exceptions remain
       intentionally absent. Re-evaluate this file if the engine's execution model changes. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
