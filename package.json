{
  "name": "ossia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:desktop": "pnpm --filter @ossia/desktop build",
    "build:headless": "cargo build -p ossia-desktop --no-default-features",
    "build:web": "pnpm --filter @ossia/ui build",
    "check": "vp check",
    "check:contracts": "cargo run --quiet -p ossia-runtime --bin generate-contracts -- --check",
    "check:fix": "vp check --fix",
    "check:types": "cargo run --quiet -p ossia-types --bin generate-types -- --check",
    "dev:desktop": "pnpm --filter @ossia/desktop dev",
    "dev:runtime": "node scripts/runtime-dev.mjs",
    "dev:web": "pnpm --filter @ossia/ui dev",
    "engine:install": "node scripts/engine.mjs install --download",
    "engine:verify": "node scripts/engine.mjs verify",
    "generate:contracts": "cargo run --quiet -p ossia-runtime --bin generate-contracts --",
    "generate:types": "cargo run --quiet -p ossia-types --bin generate-types --",
    "package": "node scripts/package.mjs",
    "setup": "pnpm install && pnpm engine:install",
    "test:engine": "node --test scripts/engine.test.mjs",
    "test:integrations": "cargo test -p ossia-integrations",
    "test:package": "node --test scripts/package.test.mjs",
    "test:release": "node --test scripts/release/version.test.mjs scripts/release/tags.test.mjs scripts/release/assets.test.mjs scripts/release/notes.test.mjs",
    "test:ui": "pnpm --filter @ossia/ui test",
    "test:ui:native": "pnpm --filter @ossia/ui test:native",
    "typecheck": "pnpm run -r typecheck"
  },
  "devDependencies": {
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "pnpm@12.4.1"
}
