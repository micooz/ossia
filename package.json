{
  "name": "ossia",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "engine:verify": "node scripts/engine.mjs verify",
    "engine:install": "node scripts/engine.mjs install",
    "setup": "pnpm install && pnpm engine:install",
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --parallel --filter @ossia/backend --filter @ossia/ui dev",
    "dev:api": "pnpm --filter @ossia/backend dev",
    "dev:ui": "pnpm --filter @ossia/ui dev",
    "dev:desktop": "pnpm --filter @ossia/desktop dev",
    "desktop:build": "pnpm --filter @ossia/desktop build",
    "typecheck": "pnpm run -r typecheck",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test:desktop": "pnpm --filter @ossia/desktop test"
  },
  "devDependencies": {
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "pnpm@12.4.1"
}
