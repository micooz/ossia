{
  "name": "ossia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:desktop": "pnpm --filter @ossia/desktop build",
    "build:headless": "cargo build -p ossia-desktop --no-default-features",
    "build:web": "pnpm --filter @ossia/ui build",
    "check": "pnpm generate:types && vp check",
    "check:contracts": "cargo run --quiet -p ossia-runtime --bin generate-contracts -- --check",
    "check:fix": "pnpm generate:types && vp check --fix",
    "check:types": "cargo run --quiet -p ossia-types --bin generate-types -- --check",
    "dev:desktop": "pnpm --filter @ossia/desktop dev",
    "dev:runtime": "node scripts/runtime-dev.mjs",
    "dev:web": "pnpm --filter @ossia/ui dev",
    "engine:install": "node scripts/engine.mjs install --download",
    "engine:verify": "node scripts/engine.mjs verify",
    "generate:contracts": "cargo run --quiet -p ossia-runtime --bin generate-contracts --",
    "generate:types": "cargo run --quiet -p ossia-types --bin generate-types --",
    "package": "node scripts/package.mjs",
    "setup": "pnpm install && pnpm engine:install && pnpm docs:prepare",
    "test:engine": "node --test tests/scripts/engine.test.mjs",
    "test:package": "node --test tests/scripts/package.test.mjs",
    "test:release": "node --test tests/scripts/release/version.test.mjs tests/scripts/release/tags.test.mjs tests/scripts/release/assets.test.mjs tests/scripts/release/notes.test.mjs",
    "test:ui": "pnpm --filter @ossia/ui test",
    "test:ui:native": "pnpm --filter @ossia/ui test:native",
    "docs:prepare": "node --no-warnings=ExperimentalWarning scripts/docs.mjs --download",
    "test:docs": "node --no-warnings=ExperimentalWarning --test tests/scripts/docs.test.mjs"
  },
  "devDependencies": {
    "parse5": "^8.1.1",
    "vite-plus": "^1.5.1"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "pnpm@12.4.1"
}
