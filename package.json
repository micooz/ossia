{
  "name": "ossia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "pnpm install && pnpm engine:install && pnpm generate:docs",
    "generate:docs": "node scripts/docs/generate.mjs --download",
    "generate:mcp": "cargo run --quiet -p ossia-backend --bin generate-mcp --",
    "generate:types": "cargo run --quiet -p ossia-types --bin generate-types --",
    "engine:install": "node scripts/engine/engine.mjs install --download",
    "dev:backend": "node scripts/dev/backend.mjs",
    "dev:desktop": "pnpm --filter @ossia/desktop dev",
    "dev:ui": "pnpm --filter @ossia/ui dev",
    "dev:website": "vp dev website",
    "check": "pnpm generate:types && vp check",
    "check:fix": "pnpm generate:types && vp check --fix",
    "check:mcp": "cargo run --quiet -p ossia-backend --bin generate-mcp -- --check",
    "check:types": "cargo run --quiet -p ossia-types --bin generate-types -- --check",
    "engine:verify": "node scripts/engine/engine.mjs verify",
    "test:scripts": "vp test tests/scripts",
    "test:ui": "pnpm --filter @ossia/ui test",
    "test:ui:native": "pnpm --filter @ossia/ui test:native",
    "verify": "node scripts/verify/verify.mjs",
    "verify:audition": "node scripts/verify/audition-cases.mjs",
    "verify:jianpu": "node scripts/verify/jianpu-cases.mjs",
    "verify:musicxml": "node scripts/verify/musicxml-cases.mjs",
    "verify:playback": "node scripts/verify/playback-cases.mjs",
    "verify:selection": "node scripts/verify/selection-cases.mjs",
    "audit:audition": "node scripts/verify/audition-audit.mjs",
    "audit:jianpu": "node scripts/verify/jianpu-cases.mjs --library",
    "audit:playback": "node scripts/verify/playback-audit.mjs",
    "audit:selection": "node scripts/verify/selection-cases.mjs --library",
    "build:backend": "pnpm build:ui && cargo build -p ossia-desktop --no-default-features",
    "build:desktop": "pnpm --filter @ossia/desktop build",
    "build:ui": "pnpm --filter @ossia/ui build",
    "build:website": "vp build website",
    "package": "node scripts/package/package.mjs",
    "preview:website": "vp preview website"
  },
  "devDependencies": {
    "cos-nodejs-sdk-v5": "^3.0.0",
    "parse5": "^8.1.1",
    "vite-plus": "^1.5.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.4.1"
}
