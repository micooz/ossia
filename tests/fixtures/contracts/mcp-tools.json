[
  {
    "name": "ossia_guide",
    "description": "Read the complete local score workflow and tool contract. Returns a Markdown string.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "title": "EmptyArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_status",
    "description": "Inspect runtime, engine, library, documentation and active jobs. Returns AgentStatus.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "title": "EmptyArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_list",
    "description": "List compact documents with limit/offset. Returns DocumentPage; does not load render or check history.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Bounded document listing for Agent transports.",
      "properties": {
        "limit": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "ListArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_import",
    "description": "Queue an absolute-path import. format/title/author are inferred or defaulted; returns a Job. Pass waitMs to wait for completion.",
    "inputSchema": {
      "$defs": {
        "ContentHash": {
          "type": "string"
        },
        "InputFormat": {
          "enum": [
            "ly",
            "music-xml",
            "midi"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "waitMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "title": "ImportArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_open",
    "description": "Create an isolated view and one-use browser URL. Returns AgentOpenOutcome with the initial compact context; the ticket is not exposed separately.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "OpenArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_context",
    "description": "Read this explicit view's compact document, selection, source spans and event cursor. Returns AgentView.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Identify one isolated view for a context read.",
      "properties": {
        "viewId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "viewId"
      ],
      "title": "ViewArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_edit",
    "description": "Begin, resume, end or discard an owned edit; recovery actions are advanced. Returns EditSession or null. Keep editId private.",
    "inputSchema": {
      "$defs": {
        "ContentHash": {
          "type": "string"
        },
        "EditAction": {
          "enum": [
            "begin",
            "resume",
            "end",
            "discard",
            "resolve-recovery-conflict"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/EditAction"
        },
        "adoptWorkspace": {
          "default": false,
          "type": "boolean"
        },
        "author": {
          "default": "agent",
          "type": "string"
        },
        "baseVersionId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "documentId": {
          "format": "uuid",
          "type": "string"
        },
        "editId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "expectedSourceHash": {
          "$ref": "#/$defs/ContentHash"
        },
        "viewId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "action",
        "documentId",
        "viewId",
        "expectedSourceHash"
      ],
      "title": "EditArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_write_source",
    "description": "Atomically replace or batch-edit the active owned source and return the computed hash. The document is derived from editId.",
    "inputSchema": {
      "$defs": {
        "ContentHash": {
          "type": "string"
        },
        "SourceEdit": {
          "additionalProperties": false,
          "description": "One exact original-text replacement. Empty text inserts or deletes.",
          "properties": {
            "expectedText": {
              "type": "string"
            },
            "replacement": {
              "type": "string"
            },
            "span": {
              "$ref": "#/$defs/SourceSpan"
            }
          },
          "required": [
            "span",
            "expectedText",
            "replacement"
          ],
          "type": "object"
        },
        "SourcePosition": {
          "properties": {
            "byte": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "column": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "line": {
              "description": "One-based line and Unicode scalar column, including a retained BOM or CR.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "byte",
            "line",
            "column"
          ],
          "type": "object"
        },
        "SourceSpan": {
          "properties": {
            "byteEnd": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "byteStart": {
              "description": "Half-open byte range. Consumers must validate it against the same source snapshot.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "end": {
              "$ref": "#/$defs/SourcePosition"
            },
            "start": {
              "$ref": "#/$defs/SourcePosition"
            }
          },
          "required": [
            "byteStart",
            "byteEnd",
            "start",
            "end"
          ],
          "type": "object"
        },
        "SourceWriteChange": {
          "description": "Whole-source replacement or one atomic batch of non-overlapping edits.",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "replace",
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "text"
              ],
              "type": "object"
            },
            {
              "properties": {
                "edits": {
                  "items": {
                    "$ref": "#/$defs/SourceEdit"
                  },
                  "type": "array"
                },
                "kind": {
                  "const": "edit",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "edits"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Apply one atomic source change to the active owned edit.",
      "properties": {
        "change": {
          "$ref": "#/$defs/SourceWriteChange"
        },
        "editId": {
          "format": "uuid",
          "type": "string"
        },
        "expectedSourceHash": {
          "$ref": "#/$defs/ContentHash"
        },
        "viewId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "viewId",
        "editId",
        "expectedSourceHash",
        "change"
      ],
      "title": "WriteSourceArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_read_source",
    "description": "Read a bounded UTF-8-safe source page at an exact source hash. Returns ReadSourceOutcome with the next span.",
    "inputSchema": {
      "$defs": {
        "ContentHash": {
          "type": "string"
        },
        "SourcePosition": {
          "properties": {
            "byte": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "column": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "line": {
              "description": "One-based line and Unicode scalar column, including a retained BOM or CR.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "byte",
            "line",
            "column"
          ],
          "type": "object"
        },
        "SourceReadStart": {
          "description": "Start of a bounded source read. Line numbers are one-based.",
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "start",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "line",
                  "type": "string"
                },
                "line": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "line"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "span",
                  "type": "string"
                },
                "span": {
                  "$ref": "#/$defs/SourceSpan"
                }
              },
              "required": [
                "kind",
                "span"
              ],
              "type": "object"
            }
          ]
        },
        "SourceSpan": {
          "properties": {
            "byteEnd": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "byteStart": {
              "description": "Half-open byte range. Consumers must validate it against the same source snapshot.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "end": {
              "$ref": "#/$defs/SourcePosition"
            },
            "start": {
              "$ref": "#/$defs/SourcePosition"
            }
          },
          "required": [
            "byteStart",
            "byteEnd",
            "start",
            "end"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Read a bounded portion of the public source at one exact hash.",
      "properties": {
        "documentId": {
          "format": "uuid",
          "type": "string"
        },
        "expectedSourceHash": {
          "$ref": "#/$defs/ContentHash"
        },
        "maxBytes": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maxLines": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReadStart"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "documentId",
        "viewId",
        "expectedSourceHash"
      ],
      "title": "ReadSourceArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_docs",
    "description": "Search or read the bundled offline LilyPond documentation. Search takes query/limit; read takes chapterId/offset/limit. Returns DocsOutcome.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Search keywords or read one stable chapter ID with character-based pagination.",
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "search",
              "type": "string"
            },
            "limit": {
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "query": {
              "type": "string"
            }
          },
          "required": [
            "action",
            "query"
          ],
          "type": "object"
        },
        {
          "properties": {
            "action": {
              "const": "read",
              "type": "string"
            },
            "chapterId": {
              "type": "string"
            },
            "limit": {
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "offset": {
              "default": 0,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "action",
            "chapterId"
          ],
          "type": "object"
        }
      ],
      "title": "DocsRequest"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_job",
    "description": "Get or cancel a durable job. Optionally wait with waitMs; section pages performance, source or differences evidence. Returns JobOutcome.",
    "inputSchema": {
      "$defs": {
        "AnalysisSection": {
          "description": "Which immutable evidence to page through.",
          "enum": [
            "performance",
            "source",
            "differences"
          ],
          "type": "string"
        },
        "DetailLevel": {
          "description": "Agent responses are compact unless the caller explicitly requests full evidence.",
          "enum": [
            "summary",
            "full"
          ],
          "type": "string"
        },
        "JobAction": {
          "enum": [
            "get",
            "cancel"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/JobAction"
        },
        "detail": {
          "$ref": "#/$defs/DetailLevel",
          "default": "summary"
        },
        "jobId": {
          "format": "uuid",
          "type": "string"
        },
        "limit": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "section": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisSection"
            },
            {
              "type": "null"
            }
          ]
        },
        "waitMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "jobId",
        "action"
      ],
      "title": "JobArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_check",
    "description": "Queue a check of exact expectedSourceHash; documentId is derived from editId when supplied. Returns a Job; poll with ossia_job.",
    "inputSchema": {
      "$defs": {
        "ContentHash": {
          "type": "string"
        },
        "ExpectedNote": {
          "additionalProperties": false,
          "description": "Expected MIDI pitch and exact quarter-note timing.",
          "properties": {
            "duration": {
              "$ref": "#/$defs/QuarterTime"
            },
            "pitch": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "start": {
              "$ref": "#/$defs/QuarterTime"
            }
          },
          "required": [
            "pitch",
            "start",
            "duration"
          ],
          "type": "object"
        },
        "MusicExpectation": {
          "additionalProperties": false,
          "description": "Only explicitly supplied conditions are checked.",
          "properties": {
            "noteCount": {
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tracks": {
              "default": [],
              "items": {
                "$ref": "#/$defs/TrackExpectation"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "QuarterTime": {
          "additionalProperties": false,
          "description": "Exact nonnegative time measured in quarter notes. Denominator must be nonzero.",
          "properties": {
            "denominator": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "numerator": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "type": "object"
        },
        "TrackExpectation": {
          "additionalProperties": false,
          "description": "An exact ordered sequence in one MIDI track/channel; simultaneous pitches sort ascending.",
          "properties": {
            "channel": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "notes": {
              "items": {
                "$ref": "#/$defs/ExpectedNote"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "pitches": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "track": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "track",
            "channel"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "editId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "expect": {
          "anyOf": [
            {
              "$ref": "#/$defs/MusicExpectation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expectedSourceHash": {
          "$ref": "#/$defs/ContentHash"
        },
        "viewId": {
          "format": "uuid",
          "type": "string"
        },
        "waitMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "viewId",
        "expectedSourceHash"
      ],
      "title": "CheckArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_commit",
    "description": "Commit the exact checked source through editId. Creates a Version; base version is derived from the edit.",
    "inputSchema": {
      "$defs": {
        "ContentHash": {
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "editId": {
          "format": "uuid",
          "type": "string"
        },
        "expectedSourceHash": {
          "$ref": "#/$defs/ContentHash"
        },
        "summary": {
          "type": "string"
        },
        "viewId": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "viewId",
        "editId",
        "expectedSourceHash",
        "summary"
      ],
      "title": "CommitArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_history",
    "description": "Page through distinct version nodes. Returns VersionPage with limit/offset.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "format": "uuid",
          "type": "string"
        },
        "limit": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "documentId"
      ],
      "title": "HistoryArgs",
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "ossia_restore",
    "description": "Queue restoration of a version as a new version. Requires a clean workspace and no active edit; returns a Job.",
    "inputSchema": {
      "$defs": {
        "ContentHash": {
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseVersionId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
