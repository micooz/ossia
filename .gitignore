# spike 派生产物：LilyPond 渲染输出，可由 work/samples/render.mjs 再生成
work/samples/svg/
# Node / OS
node_modules/
# Env files are never committed (`.env*`, all modes): they are deployment configuration and the
# only sane home for OSSIA_MODEL_API_KEY. The two files the app expects are documented inline in
# .docs/2026-10-09_mvp-build.md §9.3; anything that must ship belongs in code defaults or the real
# deployment environment, not in the repo.
.env*

.pnpm-store/
.DS_Store

# Pre-MVP spike scripts and their sample output: kept on disk as evidence, not tracked,
# and excluded from vp fmt/lint (see vite.config.ts).
work/

# MVP build artifacts (see .docs/2026-10-09_mvp-build.md)
# The LilyPond engine is vendored on disk but never committed: it is reproducible
# from vendor/ENGINE.lock, and scripts/engine.mjs self-heals it at startup.
vendor/lilypond/
vendor/dist/
.ossia/
.next/
# Generated by `next dev` / `next build` (type references into .next); it is machine- and
# version-specific, and Next rewrites it on the first run.
next-env.d.ts
# Safety net only: no package sets `incremental` any more (measured 2026-10-10: warm typecheck was
# 0.216s with the cache vs 0.123s without it, so it costs more than it saves here). Keeps an ad-hoc
# `tsc --incremental` run from showing up as a 258 KB untracked artifact.
*.tsbuildinfo
packages/*/dist/
packages/desktop/src-tauri/target/
packages/desktop/src-tauri/binaries/
packages/desktop/src-tauri/gen/
